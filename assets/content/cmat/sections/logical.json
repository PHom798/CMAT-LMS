  "topics": [
    {
      "id": "logical-series",
      "title": "Series",
      "description": "Find the rule behind number and letter series.",
      "lessons": [
        {
          "id": "cmat-logical-1",
          "title": "Number series",
          "objective": "Spot the rule behind a number series and find the next term.",
          "estimatedMinutes": 5,
          "activities": [
            {
              "type": "concept",
              "title": "Look at the gaps",
              "body": "Most series follow one rule. Write down the difference between each pair of numbers and look for a pattern.",
              "example": "3, 7, 11, 15, ?\nGaps: +4, +4, +4\nNext: 15 + 4 = 19"
            },
            {
              "type": "concept",
              "title": "When the gaps change",
              "body": "If the gaps are not equal, check whether the gaps themselves grow, or whether each term is multiplied or squared.",
              "example": "2, 4, 8, 16, ?  → each term × 2 → 32\n1, 4, 9, 16, ?  → 1², 2², 3², 4² → 25"
            },
            {
              "id": "logical-series-q1",
              "type": "multipleChoice",
              "prompt": "What comes next?",
              "snippet": "5, 10, 20, 40, ?",
              "options": [
                "80",
                "45",
                "60",
                "100"
              ],
              "correctIndex": 0,
              "explanation": "Each term doubles, so 40 × 2 = 80."
            },
            {
              "id": "logical-series-q2",
              "type": "multipleChoice",
              "prompt": "What comes next?",
              "snippet": "1, 3, 6, 10, 15, ?",
              "options": [
                "18",
                "20",
                "21",
                "25"
              ],
              "correctIndex": 2,
              "hint": "Look at how the gaps change.",
              "explanation": "The gaps are +2, +3, +4, +5, so the next gap is +6: 15 + 6 = 21."
            },
            {
              "id": "logical-series-q3",
              "type": "multipleChoice",
              "prompt": "Which number is the odd one out?",
              "snippet": "3, 5, 7, 9, 11",
              "options": [
                "3",
                "9",
                "7",
                "11"
              ],
              "correctIndex": 1,
              "explanation": "All the others are prime numbers. 9 is not prime, because 9 = 3 × 3."
            }
          ]
        }
      ],
      "checkpoint": {
        "passPercent": 60,
        "questions": [
          {
            "id": "logical-series-cp1",
            "type": "multipleChoice",
            "prompt": "What comes next?",
